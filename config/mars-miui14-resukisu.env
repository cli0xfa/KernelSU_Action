# Xiaomi Mi 11 Pro (mars) — ReSukiSU
#
# Device, kernel source, defconfig fragments, toolchain, watchdog handling and
# packaging are all inherited from config/mars-miui14.env via INCLUDE; only the
# KernelSU choice differs. Run it the same way:
#
#   Actions -> Build Kernel -> Config file to build =
#   config/mars-miui14-resukisu.env
#
# ---------------------------------------------------------------------------
# Why ReSukiSU
# ---------------------------------------------------------------------------
# Official KernelSU is a dead end here: upstream dropped non-GKI support at
# v1.0, and 5.4 is GKI 1.0, so v0.9.5 (already built and verified working on
# this device) is the end of that line.
#
# SukiSU-Ultra cannot be used at all. It has no pre-5.10 SELinux path:
# selinux/rules.c and feature/selinux_hide.c both reach straight into
# selinux_state.policy / .policy_mutex / .status_lock / .status_page, none of
# which exist before 5.10 (policy and policy_mutex first appear in v5.10 --
# verified against upstream headers v5.4 through v5.10, where 5.4 keeps them in
# struct selinux_ss instead). Those files are compiled unconditionally, so it is
# a hard compile error, and its own SELINUX_POLICY_INSTEAD_SELINUX_SS define is
# dead code. Full write-up: docs/sukisu-5.4-incompatibility.md
#
# ReSukiSU is the SukiSU-Ultra re-fork that kept the compat layer, and it hooks
# at runtime so no kernel source patches are needed. See the resukisu entry in
# scripts/kernelsu.sh for why the ref has to be 'auto-hook' and not 'main'.
INCLUDE=mars-miui14.env

CONFIG_ENV=config/mars-miui14-resukisu.env

# =============================================================== KernelSU ===
KSU_VARIANT=resukisu

# v4.2.0-rc3, chosen so the kernel driver version MATCHES the manager.
#
# ReSukiSU derives its version from the commit count of whatever ref is checked
# out (kernel/Kbuild):
#
#     KSU_LOCAL_VERSION := git rev-list --count HEAD
#     KSU_VERSION       := 30000 + KSU_LOCAL_VERSION + 700
#
# Measured against the real repo:
#     auto-hook branch : 4375 commits -> 35075
#     v4.2.0-rc3 tag   : 4471 commits -> 35171   <- manager is 35171/4
#
# So building the tag makes the driver version equal the manager's, which is
# what clears the manager's "kernel needs update" notice. Building the branch
# left it 96 commits behind and the manager flagged a mismatch.
#
# The tag also has everything the tracepoint hook needs: hook/arm64/syscall_hook.c,
# syscall_hook_manager.c, syscall_event_bridge.c and tp_marker.c are all present,
# and it registers BOTH __NR_execve and __NR_execveat (auto-hook registered only
# execve). It lacks auto_hook.c/inline_hook.c, which this configuration does not
# use -- the tracepoint path is what works on a CONFIG_CFI_CLANG kernel.
#
# It still needs the same two source fixes, both already automated:
# resukisu_enable_tracepoint.sh (the GKI-2.0-only $(error)) and
# resukisu_fix_fsnotify_ops.sh (handle_inode_event, 5.9+). It uses $(KSU_SRC) for
# its source directory, which ksu_fix_legacy_symbols() detects.
KSU_REF=v4.2.0-rc3

# ---------------------------------------------------------------------------
# Hook mode: 'manual'
# ---------------------------------------------------------------------------
# Deliberately NOT 'runtime'. ReSukiSU names its hooks differently from
# SukiSU-Ultra and the 'runtime' mode added for the latter would warn and set
# nothing, leaving CONFIG_KSU_MANUAL_HOOK unset -- and ReSukiSU's
# core/init.c has `#error "Unsupported hook type"` when no hook mode symbol is
# defined, so the build would fail on the pin rather than silently.
#
# 'manual' is correct here even though it sounds source-integrated. On the
# 'auto-hook' ref its Kbuild does:
#
#     else ifdef CONFIG_KSU_MANUAL_HOOK
#       include $(KSU_SRC)/tools/auto_hook_detect.mk
#       ifneq ($(CONFIG_KALLSYMS_ALL),y)
#         include $(KSU_SRC)/tools/manual_hook_check.mk   # the $(error) check
#       endif
#
# This kernel sets CONFIG_KALLSYMS_ALL=y, so the check that demands
# hand-patched call sites is skipped entirely, and auto_hook_detect.mk instead
# sets -DKSU_HOOK_AUTO_EXECVE_HOOK etc. for whichever hooks are missing from the
# tree. hook/auto_hook.c then installs them at runtime via
# ksu_inline_hook_register(), so nothing in the kernel source is edited.
#
# ---------------------------------------------------------------------------
# Hook mode: 'tracepoint' via a patch, NOT 'manual'
# ---------------------------------------------------------------------------
# The pre-GKI default is 'manual', and that is what the first ReSukiSU build
# used. It produced a kernel that booted and ran the driver but could not grant
# root, because hook/inline_hook.c refuses every install:
#
#     inline_hook: reject non-text target=ffffffd2da979eb0 dispatcher=ffffffd2da68365c
#     ksu_hook_sys_execve: failed to hook do_execve: -22
#
# It gates on kernel_text_address() for both the target and the dispatcher, and
# this kernel sets CONFIG_CFI_CLANG=y + CONFIG_LTO_CLANG=y, which places those
# functions outside the ranges that predicate accepts. All 7 inline hooks were
# refused, including the execve one that rewrites /system/bin/su -> /data/adb/ksud
# -- so `su` had no escalation path at all.
#
# The tracepoint hook does not patch function text. It redirects at syscall
# entry by pointing regs->syscallno at a spare ni_syscall slot that holds a
# shared dispatcher, installed with ksu_syscall_table_hook() -- the mechanism
# already reporting `patch result=0` here.
#
# ReSukiSU refuses this mode on non-GKI 2.0 with a hard $(error). That gate is
# about what upstream tested, not what the code needs:
#   * the hook needs the sys_enter tracepoint, declared under
#     CONFIG_HAVE_SYSCALL_TRACEPOINTS, which this kernel sets (=y).
#     CONFIG_FTRACE_SYSCALLS is unset, but that only governs tracefs visibility,
#     not KernelSU registering its own probe.
#   * the path uses no post-5.4 API; its version checks already fall back
#     correctly on 5.4 (tp_marker.c -> TIF_SYSCALL_TRACEPOINT below 5.11,
#     syscall_hook_manager.c -> compat.h below 6.7).
#
# KSU_RESUKISU_KERNEL_TP_FIX runs patches/resukisu_enable_tracepoint.sh, which
# rewrites that one Kbuild block and nothing else. Kernel source is untouched.
KSU_HOOK_MODE=tracepoint
KSU_RESUKISU_KERNEL_TP_FIX=true

# Patching is still skipped: the tracepoint path installs its own hooks, and the
# legacy script externs ksu_vfs_read_hook / ksu_handle_vfs_read /
# ksu_execveat_hook, none of which ReSukiSU defines -- its check_incompatible.mk
# even $(error)s on seeing those names.
KSU_HOOKS_AUTO_HOOKED=true

# ---------------------------------------------------------------------------
# Debug mode: on deliberately, to prove root on the first boot
# ---------------------------------------------------------------------------
# CONFIG_KSU_DEBUG=y makes the kernel grant root to uid 2000 (adb shell) with no
# manager interaction. That is the only practical way to verify root on this
# device: MIUI refuses injected input over adb ("requires ... INJECT_EVENTS"),
# so tapping Grant in the manager is impossible, and the allowlist starts empty
# (which is exactly what defeated the first v0.9.5 boot test until it was
# seeded by hand).
#
# Switch to false and rebuild for a production kernel; root then needs a normal
# manager grant. ReSukiSU supports several managers, including the official
# KernelSU one.
EXTRA_DEFCONFIG=CONFIG_QCOM_WATCHDOG_BARK_TIME=20000 CONFIG_QCOM_WATCHDOG_PET_TIME=15000 CONFIG_KSU_DEBUG=y

# Assert the symbols this variant's hook strategy depends on, on top of the base
# profile's device-symbol list (which stays in mars-miui14.env). A missing one
# does not fail the kernel build -- it produces a kernel that boots and simply
# never gets root, which is the failure mode worth failing CI over.
#
#   TRACEPOINT_HOOK           selects the syscall-redirect hook (see above)
#   HAVE_SYSCALL_TRACEPOINTS  the tracepoint the hook registers against; this is
#                             the real requirement, and the reason the upstream
#                             GKI-2.0 gate does not apply here
#   KALLSYMS_ALL              hook/arm64/syscall_hook.c resolves sys_call_table
#                             through it
#   KSU_DEBUG                 the adb-shell auto-root used to verify root works
KERNEL_REQUIRED_CONFIG_EXTRA=CONFIG_KSU=y CONFIG_KSU_TRACEPOINT_HOOK=y CONFIG_KSU_DEBUG=y CONFIG_HAVE_SYSCALL_TRACEPOINTS=y CONFIG_TRACEPOINTS=y CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_KPROBES=y CONFIG_KRETPROBES=y
