# =============================================================================
# EXPERIMENTAL: find why ReSukiSU v4.2.0-rc3 does not boot on mars
#
# The moment it boots, we get UAPI 4 and the manager stops hiding its Modules and
# Superuser tabs. The auto-hook branch works but is stuck at UAPI 2.
#
# This profile builds the v4.2.0-rc3 tag with the additions that auto-hook does
# not have disabled, one group at a time, so the culprit can be identified by
# bisection instead of guessed at from a code diff.
#
# The four call sites that differ, and why each is a suspect:
#
#   APP_PROFILE_INIT    core/init.c calls ksu_app_profile_init(), which auto-hook
#                       never calls at all. A new init path is a new chance to
#                       fault before userspace starts.
#   MODULE_LOAD_FILTER  core/init.c calls ksu_module_load_filter_hook_init(), and
#                       feature/module_load_filter.o is compiled unconditionally
#                       -- there is no Kconfig for it. It installs its own
#                       syscall-table hooks for init_module/finit_module, which
#                       is a second, independent user of the table patcher the
#                       tracepoint hook already relies on.
#   SESSION_KEYRING     setup_ksu_cred() calls ksu_get_session_keyring()
#                       unconditionally, where auto-hook only did so under
#                       KSU_COMPAT_REQUIRE_SESSION_KEYRING.
#   PUT_CRED_GUARD      kernel_exit() calls put_cred(ksu_cred) unconditionally,
#                       where auto-hook guarded it with `if (ksu_cred)`. rc3 also
#                       added an early `return -ENOSYS` when prepare_creds()
#                       fails, which can leave ksu_cred NULL.
#
# Start with MODULE_LOAD_FILTER, the most structurally invasive of the four.
# =============================================================================
INCLUDE=mars-miui14.env

KSU_VARIANT=resukisu
KSU_REF=v4.2.0-rc3
KSU_HOOK_MODE=tracepoint
KSU_RESUKISU_KERNEL_TP_FIX=true
KSU_HOOKS_AUTO_HOOKED=true

# Version and uapi come from the tag itself, which is the point of using it: no
# KSU_VERSION_PIN is needed here.
EXTRA_DEFCONFIG=CONFIG_QCOM_WATCHDOG_BARK_TIME=20000 CONFIG_QCOM_WATCHDOG_PET_TIME=15000 CONFIG_KSU_DEBUG=y

# No bisect switches on the first attempt: this reproduces the known-bad build
# to confirm the failure is reproducible from the current config, before
# attributing it to any single change.
KSU_BISECT_SWITCHES=

KERNEL_REQUIRED_CONFIG_EXTRA=CONFIG_KSU=y CONFIG_KSU_TRACEPOINT_HOOK=y CONFIG_KSU_DEBUG=y CONFIG_HAVE_SYSCALL_TRACEPOINTS=y CONFIG_TRACEPOINTS=y CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_KPROBES=y CONFIG_KRETPROBES=y
