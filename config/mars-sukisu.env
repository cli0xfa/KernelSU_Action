# KernelSU Action -- Xiaomi Mi 11 Pro (mars) build profile
#
# Device facts (probed over adb on 2026-02):
#   Xiaomi Mi 11 Pro, M2102K1AC, codename mars
#   SoC SM8350 (Lahaina), stock MIUI 14 / Android 13
#   shipped kernel 5.4.210-qgki-g71d7658432ee (Qualcomm GKI, android11-5.4)
#
# The exact stock 5.4.210 Xiaomi internal tree was never published, so this
# profile builds the maintained community MIUI SM8350 tree instead, pinned to
# the same 5.4.283 baseline commit that QiaoKes/mi11pro-sukisu-builder verified
# on Mi 11 Pro hardware (boots; treat first flashes as tests, see README).
#
# Mi 11 Pro shares its kernel target with Mi 11 Ultra: defconfig vendor/star.

CONFIG_ENV=config/mars-sukisu.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/EndCredits/android_kernel_xiaomi_sm8350-miui
KERNEL_SOURCE_BRANCH=ASB-2024-10-05
# Pin the exact verified 5.4.283 baseline (tip of ASB-2024-10-05) so builds are
# reproducible even if the branch moves. Blank this to track the branch tip.
KERNEL_PIN_COMMIT=6cb9f5a9edc161abda546ee23c8f8ba741655746
KERNEL_CONFIG=vendor/star_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# Labels artifacts as mars; also sets CONFIG_LOCALVERSION=-mars.
KERNEL_NAME=mars

ADD_LOCALVERSION_TO_FILENAME=false

# CLANG_TRIPLE is what this 5.4 tree's Makefile consumes for --target.
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==

# Last master-kernel-build-2022 toolchain: the newest clang that still
# compiles 5.4 QGKI vendor trees without dropped-flag churn, and the same
# generation the tree is developed against.
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# Full LLVM build (LLVM=1 LLVM_IAS=1), matching the tree's own build.sh.
USE_LLVM=true

# ===================================================================== GCC ==

# Needed as binutils for the arm32 compat vDSO and as CROSS_COMPILE anchors.
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

# SukiSU-Ultra 'builtin': the source-integrated non-GKI tree, the only ref
# that ships SUSFS Kconfig itself. On this 5.4 tree the registry's legacy
# default resolves to 'builtin' anyway; pin it explicitly for clarity.
#
# Pinned to a commit rather than the branch. The vendored patches below are
# written against this exact revision, and SukiSU has since changed the SUSFS
# interface it calls into (v2.2.0 -> v2.3.0) as well as the code these patches
# touch -- so the branch tip no longer matches them.
KSU_VARIANT=sukisu-ultra
KSU_REF=b1d534bc41941b2c818d7a1a1dac341e4aabfc2d

# builtin is a manual-hook integration on non-GKI kernels: the hooks must be
# patched into execveat/faccessat/vfs_read/stat entry points. This pinned
# patch is the one verified against the pinned kernel commit above.
KSU_HOOK_MODE=manual
KSU_HOOKS_PATCH=patches/mars/sukisu-manual-hooks-5.4.patch

# SukiSU builtin still calls two APIs that do not exist below 5.10 and has a
# sulog type mismatch on 5.4; this patch gates/fixes those.
KSU_EXTRA_PATCHES=patches/mars/sukisu-builtin-5.4-build-fixes.patch

# Custom manager APK signature. Leave blank for the official manager.
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
#
# susfs4ksu's kernel-5.4 branch is still v1.5.5 while SukiSU builtin speaks
# the SUSFS v2 interface, so use JackA1ltman's non-GKI 5.4 backport (a single
# self-contained git patch) instead.
#
# Version-matched to the pinned KernelSU revision: SUSFS v2.2.0 is what that
# builtin revision calls into. Newer backports (v2.3.0) add the
# susfs_set_current_proc_no_su() family that only the *newer* builtin needs;
# using one against the wrong side fails with "implicit declaration of
# function 'susfs_set_current_proc_no_su'". Change both together or neither.
ENABLE_SUSFS=true
SUSFS_REPO=https://github.com/JackA1ltman/NonGKI_Kernel_Build_2nd
SUSFS_BRANCH=1ad267cd0a793849127cd549ba460d559017d533
SUSFS_PATCH=Patches/Patch/susfs_patch_to_5.4.patch

# ========================================================== Extra patches ===

ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
# star_defconfig ships CONFIG_LTO_CLANG=y alongside CONFIG_SHADOW_CALL_STACK=y
# and CONFIG_CFI_CLANG=y. Linking that combination with the LLVM here dies in
# the LTO link step:
#
#   ld.lld: error: undefined symbol: __stack_chk_guard
#   make[1]: *** [Makefile:1206: vmlinux] Error 1
#
# (Shortly before it, ld.lld also reports 66 KB stack frames for the tree's
# LZ4 backport, i.e. the LTO unit is not in the shape the tree expects.)
# Turning LTO off keeps SCS and CFI, matches what the reference builder ships,
# and costs only link-time optimisation.
DISABLE_LTO=true
DISABLE_CC_WERROR=false

# The SUSFS option set is auto-discovered from the installed Kconfig; these
# extras pin the hide-feature set to the reference build (SUS_PATH, SUS_MOUNT
# and SUS_KSTAT on, everything else off) and keep the tree's out-of-tree ZRAM
# dedup implementation compiled out (fatal fault captured on device).
EXTRA_DEFCONFIG=CONFIG_KSU_SUSFS_SPOOF_UNAME=n CONFIG_KSU_SUSFS_ENABLE_LOG=n CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=n CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=n CONFIG_KSU_SUSFS_OPEN_REDIRECT=n CONFIG_KSU_SUSFS_SUS_MAP=n CONFIG_ZRAM_DEDUP=n

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false

BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
