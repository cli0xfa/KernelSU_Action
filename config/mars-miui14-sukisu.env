# Xiaomi Mi 11 Pro (mars) — SukiSU-Ultra instead of official KernelSU
#
# Everything about the device, kernel source, defconfig fragments, toolchain,
# watchdog handling and packaging is inherited from config/mars-miui14.env via
# INCLUDE. Only the KernelSU choice differs. Run it the same way:
#
#   Actions -> Build Kernel -> Config file to build =
#   config/mars-miui14-sukisu.env
#
# ---------------------------------------------------------------------------
# Why SukiSU-Ultra / main rather than official KernelSU v0.9.5
# ---------------------------------------------------------------------------
# Official KernelSU is abandoned for this kernel: upstream dropped non-GKI
# support at v1.0, and 5.4 is GKI 1.0. v0.9.5 (already built and verified
# working on this device) is the end of that line. SukiSU-Ultra is an actively
# maintained fork that still supports it.
#
# ---------------------------------------------------------------------------
# Why 'main' and NOT 'builtin'
# ---------------------------------------------------------------------------
# 'builtin' is the source-integrated tree and cannot link here without SUSFS:
#
#   * kernel/runtime/ksud.c *uses* is_first_zygote under a bare
#     `#ifdef KSU_COMPAT_USE_STATIC_KEY`, and that macro is defined for every
#     kernel >= 4.3 -- so it is always defined on 5.4;
#   * but kernel/hook/lsm_hook.c *defines* it only under
#     `#if defined(CONFIG_KSU_SUSFS) && defined(KSU_COMPAT_USE_STATIC_KEY)`.
#
# So CONFIG_KSU_SUSFS=y is mandatory there, and builtin ships no SUSFS sources:
# it expects susfs4ksu's kernel patch. That patch does not apply to this tree.
# Verified against EndCredits/android_kernel_xiaomi_sm8350-miui @ ASB-2024-10-05
# by dry-running 50_add_susfs_in_kernel-5.4.patch (80 hunks, 22 files):
#
#   * fs/proc/fd.c hunk #3 fails even at fuzz 3. The tree's seq_printf() emits
#     3 fields; the patch rewrites it to 4 to add `ino`. Its context does not
#     match, so it rejects rather than fuzzing in.
#   * fs/proc/bootconfig.c does not exist in a 5.4 kernel at all.
#
# 'main' avoids all of it: it installs its own hooks at runtime, using kprobes
# plus in-place patching of sys_call_table (kernel/hook/arm64/syscall_hook.c
# via patch_memory), and needs NO kernel source patches. Its Kconfig asks only
# for `depends on KPROBES && EXT4_FS`, both already =y in this kernel.
#
# The tradeoff: 'main' has no SUSFS. If hiding is needed later, the way to get
# it is to resolve the fs/proc/fd.c and bootconfig.c rejects by hand and switch
# back to 'builtin' -- not to enable ENABLE_SUSFS here, since SUSFS has to be
# compiled into main's build rather than patched on afterwards.
INCLUDE=mars-miui14.env

CONFIG_ENV=config/mars-miui14-sukisu.env

# =============================================================== KernelSU ===
KSU_VARIANT=sukisu-ultra

# v4.2.0 is pinned rather than tracking 'main' so the artifact is reproducible
# and matches the manager APK exactly. Its Kbuild expects manager signature
# size 0x35c / hash 947ae944..., which is what SukiSU_v4.2.0_40900-release.apk
# is signed with.
KSU_REF=v4.2.0

# ---------------------------------------------------------------------------
# Hook mode: 'runtime', NOT 'auto'
# ---------------------------------------------------------------------------
# 'auto' resolves to 'manual' for every pre-5.10 kernel, and 'manual' makes
# hooks_patch_apply() run patches/legacy_ksu_hooks.sh. That script externs
# ksu_handle_execveat, ksu_handle_vfs_read, ksu_vfs_read_hook and
# ksu_input_hook -- and SukiSU's 'main' tree defines NONE of them. (Its
# ksu_handle_faccessat also takes (orig_nr, regs) rather than the legacy
# (dfd, filename, mode, flags).) The kernel would fail to link.
#
# Those symbols only ever existed for the old fork API where the kernel source
# calls into KernelSU. 'main' inverts that: it hooks at runtime and calls the
# kernel, so no source patching is wanted or possible.
KSU_HOOK_MODE=runtime

# ---------------------------------------------------------------------------
# Debug mode: on deliberately, and then tested off
# ---------------------------------------------------------------------------
# CONFIG_KSU_DEBUG=y sets `allow_shell = true` unconditionally in
# kernel/core/init.c, which makes the kernel grant root to uid 2000 (adb shell)
# without any manager interaction. That is the cleanest way to prove root works
# on a first boot on this device: MIUI refuses injected input over adb
# ("requires ... INJECT_EVENTS"), so tapping Grant in the manager is not
# possible here, and the allowlist starts empty.
#
# It also turns on a debug-manager-appid parameter and extra signature logging.
# Once root is confirmed, switch this to false and rebuild for a production
# kernel; root then needs a manager grant like normal.
#
# KSU_DEBUG is optional: enable it for this first verification build.
#
# It is appended here rather than asserted through KERNEL_REQUIRED_CONFIG, so
# the base profile's device-symbol list (touch, fingerprint, wifi, watchdog)
# stays the single source of truth and cannot drift out of sync with this file.
EXTRA_DEFCONFIG=CONFIG_QCOM_WATCHDOG_BARK_TIME=20000 CONFIG_QCOM_WATCHDOG_PET_TIME=15000 CONFIG_KSU_DEBUG=y

# Assert the symbols this variant's hook strategy depends on, on top of the
# base profile's device-symbol list (which stays in mars-miui14.env). If any is
# missing the kernel still builds and boots -- it just silently never gets
# root, which is the exact failure mode worth failing the build over.
#
#   KPROBES / KRETPROBES / KPROBE_EVENTS  what 'main' registers its hooks with
#   TRACEPOINTS                           syscall tracepoints, used alongside
#   EXT4_FS                               a hard `depends on` of CONFIG_KSU
#   KSU_DEBUG                             the adb-shell auto-root used to verify
KERNEL_REQUIRED_CONFIG_EXTRA=CONFIG_KSU=y CONFIG_KSU_DEBUG=y CONFIG_KPROBES=y CONFIG_KRETPROBES=y CONFIG_KPROBE_EVENTS=y CONFIG_HAVE_KPROBES=y CONFIG_TRACEPOINTS=y CONFIG_EXT4_FS=y
