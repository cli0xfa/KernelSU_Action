# Xiaomi Mi 11 Pro (mars / M2102K1AC), SM8350 "lahaina", MIUI 14 / Android 13
# Stock kernel: 5.4.210-qgki-g71d7658432ee (V14.0.11.0.TKACNXM), security patch 2023-09-01
#
# Run it with:  Actions -> Build Kernel -> Config file to build =
#               config/mars-miui14.env
#
# ---------------------------------------------------------------------------
# Why this device needs special handling
# ---------------------------------------------------------------------------
# mars has no vendor_dlkm partition; its 115 loadable drivers live in
# /vendor/lib/modules (a logical partition inside `super`, mounted from an
# erofs image with dm-verity on). The kernel is built with
# CONFIG_MODVERSIONS=y and CONFIG_CFI_CLANG=y, and does *not* set
# CONFIG_MODULE_FORCE_LOAD.
#
# That combination makes the stock modules unusable on a kernel built from
# any tree other than Xiaomi's own: module loadability is decided by the CRCs
# in the kernel's __kcrctab, and genksyms derives those from the *source
# tree's* header type signatures. Xiaomi has never published the 5.4.210
# Android-13 tree (MiCode only has star-r-oss, which is 5.4.61 / Android R),
# so a rebuilt kernel rejects the stock modules -- starting with the very
# first symbol, module_layout -- and display, touch, fingerprint, Wi-Fi and
# storage all fail to come up.
#
# The way out is therefore to make the kernel self-sufficient:
#   * build the drivers into the image (the defconfig below does exactly
#     that: 854 "=y" options and zero "=m"), and
#   * additionally compile and ship the modules this tree still produces
#     (Qualcomm techpack: camera / audio / datarmnet) as an AnyKernel3
#     systemless overlay, so they match this kernel's CRCs.
# BUILD_MODULES=true turns the second part on.

CONFIG_ENV=config/mars-miui14.env

# ============================================================ Kernel source ==
#
# EndCredits' tree is the MIUI-oriented SM8350 tree: it carries the mars device
# tree (arch/arm64/boot/dts/vendor/qcom/mars-sm8350.dtsi) and the MIUI
# device configs. LineageOS' android_kernel_xiaomi_sm8350 is the more active
# AOSP baseline, but it targets Lineage ROMs rather than MIUI 14.
#
# Mars is built on the *star* config: BOARD_XIAOMI_STAR selects
# BOARD_XIAOMI_LAHAINA, which selects ARCH_LAHAINA and ARCH_QCOM. There is no
# mars defconfig in any mainline tree, and Xiaomi's own star-r-oss README lists
# "Mi 11 Lite 5G, Mi 11 Pro, Mi 11 Ultra, MIX FOLD" together.
KERNEL_SOURCE=https://github.com/EndCredits/android_kernel_xiaomi_sm8350-miui
KERNEL_SOURCE_BRANCH=ASB-2024-10-05

# A Qualcomm tree is configured by a *list* of targets, not one file: make's
# %.config rule (scripts/kconfig/merge_config.sh) folds each fragment into the
# .config generated by the preceding _defconfig target. This is the same list
# the tree's own build.sh uses. Dropping the fragments produces a kernel with
# no Xiaomi board support at all, which still compiles.
KERNEL_CONFIG=vendor/lahaina-qgki_defconfig
KERNEL_CONFIG_FRAGMENTS=vendor/xiaomi_QGKI.config vendor/star_QGKI.config vendor/debugfs.config
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=mars

# Symbols that must be present in the resolved .config. A defconfig line whose
# symbol is unknown, or whose Kconfig dependency is unmet, is dropped without
# any diagnostic -- the build then succeeds while silently missing the driver.
# Every entry here was verified present in this tree's own configs
# (lahaina-qgki_defconfig + star_QGKI.config), so a failure means the fragment
# list or the tree changed underneath us.
#
# CONFIG_DRM_MSM is deliberately *not* asserted: on Qualcomm trees the display
# driver's option is exported by techpack/display/config/lahainadisp.conf
# rather than being an ordinary Kconfig symbol, and the device's own .config
# reports "# CONFIG_DRM_MSM is not set" while still loading msm_drm.ko.
KERNEL_REQUIRED_CONFIG=CONFIG_ARCH_LAHAINA=y CONFIG_ARCH_QCOM=y CONFIG_BOARD_XIAOMI_STAR=y CONFIG_DRM=y CONFIG_QCA_CLD_WLAN=y CONFIG_CNSS2=y CONFIG_ICNSS2=y CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5=y CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=y CONFIG_FINGERPRINT_GOODIX_FOD=y CONFIG_SCSI_UFS_QCOM=y CONFIG_OVERLAY_FS=y CONFIG_KPROBES=y

ADD_LOCALVERSION_TO_FILENAME=false

# The tree is built with full LLVM by its own build.sh
# (TARGET_CC=clang, LLVM=1 LLVM_IAS=1, CLANG_TRIPLE=aarch64-linux-gnu-), so
# that is the tested path. 5.4 is old enough that a thin LLVM-only build can
# trip over GNU-isms in Qualcomm's assembly, hence CLANG_TRIPLE is kept
# explicit rather than left to the tree.
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
EXTRA_CMDS:

# =================================================================== Clang ==
#
# The tree pins clang-r416183b (build.config.common:
# CLANG_PREBUILT_BIN=.../clang-r416183b/bin), and the device's own kernel was
# built with a clang 11.0.2 of the same AOSP r416183 lineage. Using a much
# newer clang on a 5.4 Qualcomm tree reliably breaks on dropped flags and
# stricter warnings.
CLANG_BRANCH=android12-release
CLANG_VERSION=r416183b

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# Full LLVM (LLVM=1 LLVM_IAS=1): the tree's own build path.
USE_LLVM=true

# No GCC binutils: LLVM provides assembler and linker here. Turning these on
# would add CROSS_COMPILE=aarch64-linux-*-, which the tree does not use.
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
#
# Official KernelSU is used rather than a fork because it is the variant with
# the most evidence of actually booting on a 5.4 QGKI SM8350 device: on the
# Mi 11 (venus, same SoC) v0.9.5 builds and boots, while KernelSU-Next's
# legacy branch was reported boot-looping and SukiSU-Ultra's builtin branch
# was reported failing on mars + MIUI 14 specifically.
#
# v0.9.5 is the last release that supports non-GKI kernels at all; upstream
# dropped them at v1.0. KSU_REF is pinned rather than left to "auto" so the
# artifact is reproducible.
KSU_VARIANT=kernelsu
KSU_REF=v0.9.5

# 5.4 is pre-GKI: kprobes is the classic source of "KernelSU installs but su
# does nothing", so manual hooks are patched into the syscall entry points
# instead. 'auto' resolves to 'manual' for anything below 5.10; being explicit
# keeps that decision visible in the log.
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
#
# Left off deliberately. susfs4ksu's kernel-5.4 branch still targets
# KernelSU's old flat layout, and adding it means patching both the kernel and
# the KernelSU tree on a device where nothing has booted yet. Enable it only
# after this configuration is known to boot and give root.
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
# path_umount() landed in Linux 5.9; KernelSU uses it to unmount its own
# overlays before a root check runs, so 5.4 needs it backported.
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
# Overlayfs backs KernelSU's module mounts and system-partition writes.
ADD_OVERLAYFS_CONFIG=true
# The tree enables CONFIG_CC_WERROR and qcacld triggers unused-function
# warnings once built in; the tree's own build.sh adds -Wno-error for exactly
# that directory. Keep warnings non-fatal as well.
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
# mars has no dtbo partition of interest here, and the boot image is repacked
# locally from the device's own stock boot image rather than in CI: doing it
# locally preserves the stock header byte-for-byte (including the 32 bytes of
# non-zero data at offset 576 that magiskboot would otherwise clear) and keeps
# the stock ramdisk, so the only variable under test is the kernel.
#
# See tools/make-bootimg.py.
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# Compile the tree's remaining loadable modules (camera / audio / datarmnet
# techpack) and ship them inside the AnyKernel3 zip as an ak3-helper
# systemless module that bind-mounts over /vendor/lib/modules. Without this,
# those drivers stay stock and cannot load on this kernel (see the header).
BUILD_MODULES=true

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
